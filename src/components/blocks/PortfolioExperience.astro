---
// ABOUTME: Presents Alex’s career as a dated timeline with skills and education.
// ABOUTME: Shares the experience app between the Spanish and English routes.
import { ArrowUpRight, BrainCircuit, CodeXml, GraduationCap, Layers, Sparkles } from 'lucide-react';
import Base from '@/layouts/BaseLayout.astro';
import { useTranslations, type Language } from '@/i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const jobs = [
  { key: 'gurusup', company: 'GuruSup', year: '2026', period: t('profile.currentPeriod') },
  { key: 'convotis', company: 'CONVOTIS Iberia', year: '2025', period: '2025–2026' },
  { key: 'aiju', company: 'AIJU', year: '2021', period: '2021–2025' },
] as const;
const skills = [
  { key: 'agents', icon: Sparkles },
  { key: 'ml', icon: BrainCircuit },
  { key: 'software', icon: CodeXml },
] as const;
const degrees = [
  { key: 'master', school: 'Universidad Internacional Menéndez Pelayo', period: '2022–2024' },
  { key: 'bachelor', school: 'Universitat Politècnica de València', period: '2017–2021' },
] as const;
---

<Base
  app={t('desktop.experience')}
  title={t('profile.experience')}
  description={t('desktop.careerIntro')}
>
  <main id="main-content" tabindex="-1">
    <section class="portfolio-wrap desktop-sheet" aria-labelledby="experience-title">
      <header class="desktop-sheet-heading">
        <h1 id="experience-title">{t('profile.experience')}</h1>
        <p class="profile-lead">{t('desktop.careerIntro')}</p>
      </header>
      <ol class="desktop-timeline" role="list">
        {jobs.map(({ key, company, year, period }) => (
          <li>
            <time datetime={year}>{year}</time>
            <div>
              <p class="portfolio-kicker">{period}</p>
              <h2>{company}</h2>
              <p class="desktop-job-role">{t(`profile.job.${key}.role`)}</p>
              <p class="portfolio-muted">{t(`profile.job.${key}.summary`)}</p>
              {key === 'gurusup' && (
                <a
                  class="portfolio-link"
                  href="https://es.linkedin.com/posts/alejandro-mira_genai-llms-agenticai-activity-7450075945643855872-YF95"
                >
                  {t('profile.announcement')} <ArrowUpRight size={16} aria-hidden="true" />
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
    <section class="credentials-band" aria-labelledby="skills-title education-title">
      <div class="wrap portfolio-wrap portfolio-section credentials-grid">
        <section aria-labelledby="skills-title">
          <div class="portfolio-heading">
            <span class="portfolio-icon">
              <Layers size={23} aria-hidden="true" />
            </span>
            <h2 id="skills-title">{t('profile.skills')}</h2>
          </div>
          <dl class="credentials-list">
            {skills.map(({ key, icon: Icon }) => (
              <div>
                <dt>
                  <Icon size={18} aria-hidden="true" />
                  {t(`profile.skill.${key}.title`)}
                </dt>
                <dd>{t(`profile.skill.${key}.tools`)}</dd>
              </div>
            ))}
          </dl>
        </section>
        <section aria-labelledby="education-title">
          <div class="portfolio-heading">
            <span class="portfolio-icon">
              <GraduationCap size={24} aria-hidden="true" />
            </span>
            <h2 id="education-title">{t('profile.education')}</h2>
          </div>
          <ul class="credentials-list" role="list">
            {degrees.map(({ key, school, period }) => (
              <li>
                <p class="portfolio-kicker">{period}</p>
                <h3>{t(`profile.degree.${key}`)}</h3>
                <p class="portfolio-muted">{school}</p>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>
  </main>
</Base>
