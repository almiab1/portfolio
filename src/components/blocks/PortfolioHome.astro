---
// ABOUTME: Builds the professional home page from career data and project evidence.
// ABOUTME: Shares the approved portrait-led profile between the two locales.
import { Image } from 'astro:assets';
import {
  ArrowDown,
  ArrowUpRight,
  BarChart3,
  BriefcaseBusiness,
  Download,
  GraduationCap,
  Sparkles,
  BrainCircuit,
  Layers,
  CodeXml,
} from 'lucide-react';
import Base from '@/layouts/BaseLayout.astro';
import Contact from '@/components/blocks/Contact.astro';
import ProjectVisual from '@/components/blocks/ProjectVisual.astro';
import portrait from '@/assets/me.png';
import healthArt from '@/assets/projects/health-dashboard.svg?url';
import { catalogSearch } from '@/lib/catalog-filters';
import { getProjectsByLang } from '@/lib/i18n-content';
import { ldPerson, ldWebsite } from '@/lib/schema';
import { useTranslations, getLocalizedUrl, type Language } from '@/i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const workUrl = getLocalizedUrl('/work', lang).replace(/\/$/, '');
const projects = await getProjectsByLang(lang);
const glio = projects.find(({ data }) => data.translationKey === 'glio-ia');
const lostScout = projects.find(({ data }) => data.translationKey === 'lost-scout');
const projectCounts = new Map<(typeof projects)[number]['data']['type'], number>();
for (const { data } of projects) {
  projectCounts.set(data.type, (projectCounts.get(data.type) ?? 0) + 1);
}
const projectTypes = [...projectCounts]
  .map(([type, count]) => ({
    type,
    count,
    label: t(`project.type.${type}`),
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, lang));
const maxProjectCount = projectTypes[0]?.count ?? 1;
const caseUrl = (id: string) => `${workUrl}/${id.replace(/^(es|en)\//, '')}`;
const jobs = [
  { key: 'gurusup', company: 'GuruSup', period: t('profile.currentPeriod') },
  { key: 'convotis', company: 'CONVOTIS Iberia', period: '2025–2026' },
  { key: 'aiju', company: 'AIJU', period: '2021–2025' },
] as const;
const skills = [
  { key: 'agents', icon: Sparkles },
  { key: 'ml', icon: BrainCircuit },
  { key: 'software', icon: CodeXml },
] as const;
const degrees = [
  { key: 'master', school: 'Universidad Internacional Menéndez Pelayo', period: '2022–2024' },
  { key: 'bachelor', school: 'Universitat Politècnica de València', period: '2017–2021' },
] as const;
---

<Base title={t('home.title')} description={t('profile.intro')}>
  {[ldPerson(), ldWebsite()].map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <main id="main-content" tabindex="-1">
    <section class="profile-hero hero" aria-labelledby="profile-title" data-enter>
      <div class="wrap portfolio-wrap profile-hero-inner">
        <div class="profile-intro">
          <p class="portfolio-kicker role-kicker">
            <Sparkles size={17} aria-hidden="true" />
            {t('profile.role')}
          </p>
          <h1 id="profile-title">
            Alejandro <span>Mira.</span>
          </h1>
          <p class="profile-specialty">{t('profile.specialty')}</p>
          <p class="profile-lead">{t('profile.intro')}</p>
          <div class="portfolio-actions">
            <a class="portfolio-button" href={workUrl}>
              {t('profile.exploreWork')} <ArrowUpRight size={18} aria-hidden="true" />
            </a>
            <a
              class="portfolio-link"
              href="/cv/eng/CV_MiraAbad_Alejandro.pdf"
              aria-label={t('profile.cv')}
              download
            >
              <Download size={17} aria-hidden="true" />
              {t('profile.heroCv')}
            </a>
          </div>
        </div>
        <div class="portrait-composition" data-enter-media>
          <div class="portrait-frame">
            <Image
              src={portrait}
              width={840}
              format="webp"
              alt={t('hero.profileAlt')}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
        <div class="profile-proof">
          <a class="career-summary" href="#about">
            <span class="portfolio-icon">
              <BriefcaseBusiness size={22} aria-hidden="true" />
            </span>
            <span>
              <span class="portfolio-kicker">{t('profile.experience')}</span>
              <strong>{jobs.map(({ company }) => company).join(' · ')}</strong>
            </span>
            <ArrowDown size={20} aria-hidden="true" />
          </a>
          {glio && (
            <a class="profile-case-proof" href={caseUrl(glio.id)}>
              <ProjectVisual project={glio} />
              <span>
                <span class="portfolio-kicker">{t('profile.heroCase')}</span>
                <strong>{t('profile.heroGlio')}</strong>
              </span>
              <ArrowUpRight size={20} aria-hidden="true" />
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="portfolio-section" id="about" aria-labelledby="experience-title">
      <div class="wrap portfolio-wrap">
        <div class="portfolio-heading">
          <h2 id="experience-title">{t('profile.experience')}</h2>
        </div>
        <ol class="career-list" role="list">
          {jobs.map(({ key, company, period }) => (
            <li>
              <p class="portfolio-kicker">{period}</p>
              <div>
                <h3>{company}</h3>
                <p class="portfolio-muted">{t(`profile.job.${key}.role`)}</p>
              </div>
              <div class="career-copy">
                <p>{t(`profile.job.${key}.summary`)}</p>
                {key === 'gurusup' && (
                  <a
                    class="portfolio-link"
                    href="https://es.linkedin.com/posts/alejandro-mira_genai-llms-agenticai-activity-7450075945643855872-YF95"
                  >
                    {t('profile.announcement')} <ArrowUpRight size={16} aria-hidden="true" />
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>
        {(glio || projectTypes.length > 0) && (
          <div class="profile-evidence">
            {glio && (
              <a class="personal-card profile-feature" href={caseUrl(glio.id)}>
                <ProjectVisual project={glio} />
                <div class="profile-feature-copy">
                  <p class="portfolio-kicker">AIJU</p>
                  <h3>GLIO-IA</h3>
                  <p class="portfolio-muted">{glio.data.summary}</p>
                  <span class="personal-action">
                    {t('profile.readGlio')} <ArrowUpRight size={19} aria-hidden="true" />
                  </span>
                </div>
              </a>
            )}
            {projectTypes.length > 0 && (
              <section class="profile-distribution" aria-labelledby="project-distribution-title">
                <div class="portfolio-icon">
                  <BarChart3 size={21} aria-hidden="true" />
                </div>
                <h3 id="project-distribution-title">{t('profile.projectDistribution')}</h3>
                <ul class="distribution-bars" role="list">
                  {projectTypes.map(({ type, count, label }) => (
                    <li data-project-type={type}>
                      <a href={workUrl + catalogSearch({ query: '', type })}>
                        <span class="distribution-label">{label}</span>
                        <span class="distribution-track" aria-hidden="true">
                          <span style={`--bar-size: ${(count / maxProjectCount) * 100}%`}></span>
                        </span>
                        <strong>{count}</strong>
                      </a>
                    </li>
                  ))}
                </ul>
                <a class="portfolio-link" href={workUrl}>
                  {t('work.viewAll')} <ArrowUpRight size={17} aria-hidden="true" />
                </a>
              </section>
            )}
          </div>
        )}
      </div>
    </section>

    <section class="credentials-band" aria-labelledby="skills-title education-title">
      <div class="wrap portfolio-wrap portfolio-section credentials-grid">
        <section aria-labelledby="skills-title">
          <div class="portfolio-heading">
            <span class="portfolio-icon">
              <Layers size={23} aria-hidden="true" />
            </span>
            <h2 id="skills-title">{t('profile.skills')}</h2>
          </div>
          <dl class="credentials-list">
            {skills.map(({ key, icon: Icon }) => (
              <div>
                <dt>
                  <Icon size={18} aria-hidden="true" />
                  {t(`profile.skill.${key}.title`)}
                </dt>
                <dd>{t(`profile.skill.${key}.tools`)}</dd>
              </div>
            ))}
          </dl>
        </section>
        <section aria-labelledby="education-title">
          <div class="portfolio-heading">
            <span class="portfolio-icon">
              <GraduationCap size={24} aria-hidden="true" />
            </span>
            <h2 id="education-title">{t('profile.education')}</h2>
          </div>
          <ul class="credentials-list" role="list">
            {degrees.map(({ key, school, period }) => (
              <li>
                <p class="portfolio-kicker">{period}</p>
                <h3>{t(`profile.degree.${key}`)}</h3>
                <p class="portfolio-muted">{school}</p>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>

    <section class="portfolio-section" id="work" aria-labelledby="personal-title">
      <div class="wrap portfolio-wrap">
        <div class="portfolio-heading portfolio-heading-split">
          <h2 id="personal-title">{t('profile.personal')}</h2>
          <a class="portfolio-link" href={workUrl}>
            {t('work.viewAll')} <ArrowUpRight size={17} aria-hidden="true" />
          </a>
        </div>
        <ul class="personal-grid" role="list">
          <li>
            <a class="personal-card card" href="https://github.com/almiab1/HealthDashboard">
              <div class="personal-image">
                <img
                  src={healthArt}
                  width="640"
                  height="360"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="personal-content">
                <p class="portfolio-kicker">{t('profile.healthType')}</p>
                <h3>HealthDashboard</h3>
                <p>{t('profile.healthSummary')}</p>
                <span class="portfolio-muted">Astro · React · MySQL</span>
                <span class="personal-action">
                  {t('profile.repository')} <ArrowUpRight size={19} aria-hidden="true" />
                </span>
              </div>
            </a>
          </li>
          {lostScout && (
            <li>
              <a class="personal-card card" href={caseUrl(lostScout.id)}>
                <div class="personal-image">
                  <ProjectVisual project={lostScout} />
                </div>
                <div class="personal-content">
                  <p class="portfolio-kicker">{t('profile.soloProject')}</p>
                  <h3>{lostScout.data.title}</h3>
                  <p>{lostScout.data.summary}</p>
                  <span class="portfolio-muted">{lostScout.data.tech.join(' · ')}</span>
                  <span class="personal-action">
                    {t('profile.readProject')} <ArrowUpRight size={19} aria-hidden="true" />
                  </span>
                </div>
              </a>
            </li>
          )}
        </ul>
      </div>
    </section>

    <Contact />
  </main>
</Base>
