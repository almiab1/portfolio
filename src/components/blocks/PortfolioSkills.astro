---
// ABOUTME: Presents Alex’s capabilities through original editorial illustrations and examples from his work.
// ABOUTME: Shares the capabilities page between the Spanish and English routes.
import { Image } from 'astro:assets';
import agents from '@/assets/capabilities/agents.webp';
import ml from '@/assets/capabilities/ml.webp';
import software from '@/assets/capabilities/software.webp';
import { ArrowUpRight } from 'lucide-react';
import Base from '@/layouts/BaseLayout.astro';
import { getLocalizedUrl, useTranslations, type Language } from '@/i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const capabilities = [
  { key: 'agents', art: agents, route: '/experience', anchor: '#gurusup' },
  { key: 'software', art: software, route: '/work', anchor: '#health-dashboard' },
  { key: 'ml', art: ml, route: '/work/glio-ia', anchor: '' },
] as const;
---

<Base app={t('desktop.skills')} title={t('desktop.skills')} description={t('desktop.skillsIntro')}>
  <main id="main-content" tabindex="-1">
    <div class="portfolio-wrap desktop-sheet">
      <header class="desktop-sheet-heading">
        <h1>{t('desktop.skills')}</h1>
        <p class="profile-lead">{t('desktop.skillsIntro')}</p>
      </header>
      <ul class="capabilities" role="list">
        {capabilities.map(({ key, art, route, anchor }) => (
          <li class="capability">
            <div class="capability-copy">
              <h2>{t(`profile.skill.${key}.title`)}</h2>
              <p>{t(`capabilities.${key}.summary`)}</p>
              <a class="portfolio-link" href={getLocalizedUrl(route, lang) + anchor}>
                {t(`capabilities.${key}.example`)} <ArrowUpRight size={16} aria-hidden="true" />
              </a>
            </div>
            <Image
              class="capability-art"
              src={art}
              alt=""
              widths={[384, 640, 960]}
              sizes="(max-width: 784px) 90vw, (max-width: 1200px) 38vw, 560px"
              loading={key === 'agents' ? 'eager' : 'lazy'}
            />
          </li>
        ))}
      </ul>
    </div>
  </main>
</Base>

<style>
  .capabilities {
    border-block-end: 1px solid var(--border);
  }

  .capability {
    display: grid;
    align-items: center;
    gap: clamp(1rem, 4cqw, 3rem);
    padding-block: clamp(1.25rem, 3.5cqw, 2.5rem);
    border-block-start: 1px solid var(--border);
  }

  .capability-copy h2 {
    font-size: clamp(1.45rem, 3.5cqw, 2.35rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    font-weight: 730;
  }

  .capability-copy p {
    max-width: 54ch;
    margin-block: 0.55rem 0.4rem;
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  .capability-art {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }

  @container (min-width: 40rem) {
    .capability {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
