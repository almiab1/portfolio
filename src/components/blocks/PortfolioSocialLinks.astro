---
// ABOUTME: Shares social profile destinations and brand icons across the portfolio.
// ABOUTME: Renders compact profile links or labelled links on the contact page.
import GithubIcon from '@/components/ui/icons/GithubIcon.astro';
import LinkedinIcon from '@/components/ui/icons/LinkedinIcon.astro';
import XIcon from '@/components/ui/icons/XIcon.astro';

interface Props {
  variant: 'profile' | 'contact';
}

const { variant } = Astro.props;
const isProfile = variant === 'profile';
const github = { href: 'https://github.com/almiab1', label: 'GitHub', icon: GithubIcon };
const linkedin = {
  href: 'https://www.linkedin.com/in/alejandro-mira/',
  label: 'LinkedIn',
  icon: LinkedinIcon,
};
const x = { href: 'https://x.com/alexmiira', label: 'X · @alexmiira', icon: XIcon };
const links = isProfile ? [github, linkedin, x] : [linkedin, github, x];
---

<div class={isProfile ? 'profile-card-social' : 'flex flex-wrap justify-center gap-x-5 gap-y-2'}>
  {links.map(({ href, label, icon: Icon }) => (
    <a
      class="portfolio-contact-social"
      href={href}
      aria-label={isProfile ? label : undefined}
      title={isProfile ? label : undefined}
      target={isProfile ? undefined : '_blank'}
      rel={isProfile ? undefined : 'noopener noreferrer'}
    >
      <Icon size={isProfile ? 19 : 20} />
      {!isProfile && <span>{label}</span>}
    </a>
  ))}
</div>
