---
// ABOUTME: Shares project artwork between the catalogue, profile, and case studies.
// ABOUTME: Uses the project's category icon when it has no dedicated illustration.
import type { CollectionEntry } from 'astro:content';
import {
  BrainCircuit,
  CircuitBoard,
  Database,
  Globe,
  Layers,
  Monitor,
  Server,
  Smartphone,
} from 'lucide-react';
interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'cover' | 'thumbnail';
}

const { project, variant = 'thumbnail' } = Astro.props;
const TYPE_ICONS = {
  ai: BrainCircuit,
  api: Server,
  data: Database,
  desktop: Monitor,
  iot: CircuitBoard,
  mobile: Smartphone,
  other: Layers,
  web: Globe,
};
const { translationKey, type } = project.data;
const art = project.data.cover.src;
const Icon = TYPE_ICONS[type];
const isCover = variant === 'cover';
---

<span
  class:list={['project-visual', { 'project-visual-category': !art, 'project-visual-source': art }]}
  data-visual-kind={art ? 'image' : 'category'}
  data-project-type={type}
  data-visual-source={art ? translationKey : undefined}
  aria-hidden="true"
>
  {art ? (
    <img
      src={art}
      width="640"
      height="360"
      alt=""
      loading={isCover ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <Icon strokeWidth={1.5} />
  )}
</span>
