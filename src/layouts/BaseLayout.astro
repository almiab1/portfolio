---
// ABOUTME: Supplies navigation, metadata, and shared site styles.
// ABOUTME: Keeps page navigation and language alternatives consistent across routes.
import { getImage } from 'astro:assets';
import portrait from '@/assets/me.png';
import DesktopFrame from '@/components/blocks/DesktopFrame.astro';
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/portfolio.css';
import '../styles/desktop.css';
import '../styles/assistant.css';
import '../styles/profile-app.css';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

export interface Props {
  app: string;
  title?: string;
  description?: string;
}
const {
  app,
  title = 'Alejandro Mira — GenAI & AI Engineer',
  description = 'Porfolio de proyectos, artículos y charlas sobre IA generativa y agentes LLM.',
} = Astro.props;

// Detectar el idioma actual de la URL
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Use the same path in both languages, including the unprefixed home.
const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(es|en)(\/|$)/, '/');

// Generar URLs completas para hreflang
const esUrl = new URL(getRelativeLocaleUrl('es', pathWithoutLang), Astro.site);
const enUrl = new URL(getRelativeLocaleUrl('en', pathWithoutLang), Astro.site);
const canonicalUrl = currentLang === 'es' ? esUrl : enUrl;
const socialImage = await getImage({ src: portrait, width: 800, format: 'jpeg' });
---

<html lang={currentLang} data-type="service" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="page-type" content="service" />
    <meta name="site-kind" content="other" />
    <meta name="theme-color" content="#f8efe5" />
    <link
      rel="preload"
      href="/fonts/inter-4.1/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Etiquetas hreflang para SEO multiidioma -->
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(socialImage.src, Astro.site)} />
    <meta property="og:image:alt" content={t('hero.profileAlt')} />
    <meta name="twitter:card" content="summary" />
    <meta property="og:locale" content={currentLang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={currentLang === 'es' ? 'en_US' : 'es_ES'} />
    <script is:inline>
      document.documentElement.classList.add('m-enter');
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <a class="portfolio-skip" href="#main-content">
      {t('common.skip')}
    </a>
    <DesktopFrame lang={currentLang} app={app}>
      <slot />
    </DesktopFrame>
    {process.env.VERCEL === '1' && <Analytics />}
  </body>
</html>
