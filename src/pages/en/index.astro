---
import Base from '@/layouts/BaseLayout.astro';
import Hero from '@/components/blocks/Hero.astro';
import About from '@/components/blocks/About.astro';
import Contact from '@/components/blocks/Contact.astro';
import { ldPerson, ldWebsite } from '@/lib/schema';
import ProjectGrid from '@/components/blocks/ProjectGrid.astro';
import NeuralBackground from '@/components/ui/NeuralBackground';

const jsonLd = [ldPerson(), ldWebsite()];
---

<Base title="Alejandro Mira — GenAI & LLM Agents" description="Portfolio, projects and articles.">
  {jsonLd.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <NeuralBackground client:only="react" />

  <main class="min-h-screen">
    <Hero />
    <About />
    <section id="work" class="scroll-mt-24">
      <ProjectGrid limit={6} moreHref="/en/work" showTitle={true} />
    </section>
    <Contact />
  </main>
</Base>
