---
// ABOUTME: Generates the en project routes from the localized content collection.
// ABOUTME: Renders each project through the shared portfolio case study.
import PortfolioCase from '@/components/blocks/PortfolioCase.astro';
import { getProjectsByLang } from '@/lib/i18n-content';

export async function getStaticPaths() {
  const projects = await getProjectsByLang('en');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/^(es|en)\//, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<PortfolioCase lang="en" project={project} />
